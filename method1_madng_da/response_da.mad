! response_da.mad
!
! Method 1: fit the measured orbit-response matrix in MAD-NG.
!
! Corrector kicks are first-order DA parameters. One closed parametric twiss
! produces d(x,y)_bpm/d(kick)_corr for every matrix cell. The quadrupole
! 32 integrated-gradient knobs are ordinary MAD.match variables; MAD.match obtains the derivative
! of each matrix-cell equality with respect to them numerically.
!
! Matrix convention:
!   rows 1..num_bpm             : horizontal BPM channels
!   rows num_bpm+1..2*num_bpm   : vertical BPM channels
!   columns                     : correctors
!
! target_mat and weight_mat have exactly that (2*num_bpm, num_corr) shape.
! Every matrix cell becomes one equality and carries its own inverse-error
! weight. A zero weight removes that individual cell from the objective.
!
! Globals supplied by run_method1.py:
!   pyi, loaded_sequence, corr_elements, quad_knobs, target_mat, weight_mat
!
! Public functions:
!   compute_response(), send_response(), run_match(...), send_quad_knobs()

local tblcat in MAD.utility
local matrix, vector, damap, match in MAD

num_corr = #corr_elements

coord_names = {'x', 'px', 'y', 'py', 't', 'pt'}
knob_names = {}
for i, name in ipairs(corr_elements) do knob_names[i] = "c_" .. name end

X0 = damap {
    nv = #coord_names,
    np = num_corr,
    mo = 1,
    po = 1,
    vn = tblcat(coord_names, knob_names),
}

for i, name in ipairs(corr_elements) do
    local element = loaded_sequence[name]
    element.kick = element.kick + X0[knob_names[i]]
end

! Monomial selecting d(orbit)/d(corrector_i) from a saved coordinate TPSA.
response_mono = {}
for i = 1, num_corr do
    response_mono[i] = "000000" .. string.rep("0", i - 1) .. "1"
end

function compute_tws()
    local tws = twiss {
        sequence = loaded_sequence,
        observe  = 1,
        X0       = X0,
        savemap  = true,
        method   = 6,
    }
    if tws == nil or (tws.lost ~= nil and tws.lost ~= 0) then return nil end
    return tws
end

! Cache a response evaluation for Python readback and establish BPM ordering.
function compute_response()
    response_tws = assert(compute_tws(), "parametric twiss failed")
    num_bpm = #response_tws
    bpm_names = {}
    for b = 1, num_bpm do bpm_names[b] = response_tws[b].name end
    return response_tws
end

function response_value(tws, row, corr)
    local bpm = row
    local coord = 'x'
    if row > num_bpm then
        bpm = row - num_bpm
        coord = 'y'
    end
    return tws[bpm].__map[coord]:get(response_mono[corr])
end

function response_matrix(tws)
    local response = matrix(2*num_bpm, num_corr)
    for row = 1, 2*num_bpm do
        for corr = 1, num_corr do
            response:set(row, corr, response_value(tws, row, corr))
        end
    end
    return response
end

! Stopping. MAD.match tests the objective (FMIN, FTOL) only at a *feasible*
! point -- ``|df| <= tol`` is checked "if c_fail = 0", every constraint within
! its own tolerance. On measured data no constraint is ever fulfilled: a BPM
! error bar is the standard error of a many-turn mean, so all 384 response cells
! fail by thousands of sigma and ``ccnt`` never reaches zero. Neither ``fmin``
! nor the objective tolerances can fire, and the match runs to ``maxcall`` long
! after the objective has stopped moving -- which is why it reported MAXCALL for
! a converged fit.
!
! XTOL is the criterion that can fire here: the manual checks the *variable*
! steps "even for non feasible points". So the stop is on the knobs -- when an
! update no longer moves any ``dk1l`` by ``var_rtol`` of itself (or by
! ``var_tol`` outright), the fit has stopped learning and returns XTOL.
function run_match(max_call, fmin, var_tol, var_rtol, info_level)
    assert(num_bpm ~= nil, "compute_response() must run before run_match()")
    assert(target_mat.nrow == 2*num_bpm and target_mat.ncol == num_corr,
           "target_mat must be (2*num_bpm) x num_corr")
    assert(weight_mat.nrow == 2*num_bpm and weight_mat.ncol == num_corr,
           "weight_mat must be (2*num_bpm) x num_corr")

    local variables = { rtol = var_rtol }
    for q, name in ipairs(quad_knobs) do
        variables[q] = {
            name = name,
            var  = "loaded_sequence['" .. name .. "']",
            tol  = var_tol,
        }
    end

    local equalities = {}
    for row = 1, 2*num_bpm do
        local bpm = row <= num_bpm and row or row-num_bpm
        local plane = row <= num_bpm and 'x' or 'y'
        for corr = 1, num_corr do
            local r, c = row, corr
            equalities[#equalities+1] = {
                name   = "R_" .. bpm_names[bpm] .. "." .. plane .. "_" .. corr_elements[c],
                expr   = \response -> response:get(r, c) - target_mat:get(r, c),
                weight = weight_mat:get(r, c),
            }
        end
    end

    return match {
        command    := response_matrix(assert(compute_tws(), "parametric twiss failed")),
        variables  = variables,
        equalities = equalities,
        objective  = { fmin = fmin, broyden = true },
        maxcall    = max_call,
        info       = info_level,
    }
end

function send_response()
    assert(response_tws ~= nil, "compute_response() must run before send_response()")
    local response = response_matrix(response_tws)
    pyi:send(bpm_names, true)
    pyi:send(response, true)
end

function send_quad_knobs()
    local values = vector(#quad_knobs)
    for q, name in ipairs(quad_knobs) do
        values:seti(q, loaded_sequence[name])
    end
    pyi:send(values, true)
end

!I don't want to implement this second order stuff, I prefer method 2 over that. What might be interesting is having a method 1.2 that is able to fit multiple response matrices (for different momenta)