TITLE, 'BOOSTER lattice';
SET,   format="20.10f";

! --------------------------------------------------------------------------------------------------
! ---Energy and particle type ----------------------------------------------------------------------
! --------------------------------------------------------------------------------------------------

if (0 == 1) {
    beam_Ek=0;
    beam_Etot = beam_Ek + pmass;
    beam_pc = sqrt(beam_Etot*beam_Etot - pmass*pmass);

    BEAM, PARTICLE=PROTON, PC=beam_pc;
} else {
    CALL, file="/afs/cern.ch/eng/acc-models/psb/2026/scenarios/lhc_indiv/1_flat_bottom/psb_fb_lhcindiv.beam";
};

BRHO := BEAM->PC * 3.3356;


! --------------------------------------------------------------------------------------------------
! --- Call lattice files ---------------------------------------------------------------------------
! --------------------------------------------------------------------------------------------------
OPTION, -echo;
CALL, file = 'acc-models-psb/psb.seq';
CALL, file = 'acc-models-psb/psb_aperture.dbx';
CALL, file = '/afs/cern.ch/eng/acc-models/psb/2026/scenarios/lhc_indiv/1_flat_bottom/psb_fb_lhcindiv.str';
CALL, file = 'acc-models-psb/_scripts/macros.madx';
OPTION, echo;

OPTION, RBARC=FALSE;

USE, sequence=psb3;

! --------------------------------------------------------------------------------------------------
! --- Match for new working point ------------------------------------------------------------------
! --------------------------------------------------------------------------------------------------

Qx = 0.165;
Qy = 0.2275;
Qxd = ;
Qyd = ;

! find integer tune
TWISS;
int_qx = floor(table(summ, q1));
int_qy = floor(table(summ, q2));
total_qx = int_qx + qx;
total_qy = int_qy + qy;

! --------------------------------------------------------------------------------------------------
! --- Install AC-Dipole ----------------------------------------------------------------------------
! --------------------------------------------------------------------------------------------------
hacmap21 = 0;
vacmap43 = 0;

hacmap: matrix, l=0, rm21 := hacmap21;
vacmap: matrix, l=0, rm43 := vacmap43;

SEQEDIT, sequence=psb3;
    FLATTEN;
    // 0.565 is the length of BR[1-4].DES3L1
    INSTALL, element=hacmap, at=0.565/2, from=BR3.DES3L1;
    INSTALL, element=vacmap, at=0.565/2, from=BR3.DES3L1;
ENDEDIT;

USE, sequence=psb3;

! --------------------------------------------------------------------------------------------------
! --- Tune Matching --------------------------------------------------------------------------------
! --------------------------------------------------------------------------------------------------
MATCH,sequence=psb3;
  VARY, NAME=kBRQF, step = 0.0001;
  VARY, NAME=kBRQD, step = 0.0001;
  CONSTRAINT, range=#E, MUX=total_qx, MUY=total_qy;
  LMDIF, calls = 10000, tolerance = 1.0E-21;
ENDMATCH;
/******************************************************************************************
 * TWISS
 ******************************************************************************************/

 PSHIFT=0;

/************************************************************
 * MAD uses pt as the 5th variable NOT delta-p.
 * The result is that all derivatives are with repect to pt.
 * This is the reason for the non-standard dispersion values
 * for non-relativistic machines, like the PSB
 ************************************************************/
 select, flag=twiss, clear;
 select, flag=twiss, pattern="^BR.*BPM[^T]",column=name, s, l, betx, bety, mux, muy, angle, k1l, k2l,k3l, x,y, r11, r12, r21, r22, alfx, alfy, dx, dpx,dpy,px,py,phix,phiy;
 twiss, centre, DELTAP = 0.0, sequence=psb3, file="./twiss.dat";

 select, flag=twiss, clear;
 select, flag=twiss,column=name, s, keyword, l, betx, bety, mux, muy, angle, k1l, k2l,k3l, x,y, r11, r12, r21, r22, alfx, alfy, dx, dpx,dpy,px,py,phix,phiy;
 twiss, centre, DELTAP = 0.0, sequence=psb3, file="./twiss_elements.dat";

 ac_s = 0;
 if (ac_s == 1) {
      select, flag=twiss, clear;
      twiss;

      betxac = table(twiss, hacmap, betx);
      betyac = table(twiss, vacmap, bety);

      hacmap21 := ac_s * (2*(cos(2*pi*Qxd)-cos(2*pi*Qx))/(betxac*sin(2*pi*Qx)));
      vacmap43 := ac_s * (2*(cos(2*pi*Qyd)-cos(2*pi*Qy))/(betyac*sin(2*pi*Qy)));

      select, flag=twiss, clear;
      select, flag=twiss, pattern="^BR.*BPM",column=name, s, l, betx, bety, mux, muy, angle, k1l, k2l,k3l, x,y, r11, r12, r21, r22, alfx, alfy, dx, dpx,dpy,px,py,phix,phiy;
      twiss, centre, DELTAP = 0, sequence=psb3, file="./twiss_ac.dat";
 }
